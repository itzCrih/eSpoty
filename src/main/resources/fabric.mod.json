{
	"schemaVersion": 1,
	"id": "espoty",
	"version": "${version}",
	"name": "eSpoty",
	"description": "Full Spotify integration in Minecraft: live playback, player controls, queue, lyrics, and modern Gold & Yellow HUD.",
	"authors": [
		"itzCrih"
	],
	"contact": {
		"homepage": "https://itzcrih.it",
		"sources": "https://github.com/itzCrih/eSpoty",
		"issues": "https://github.com/itzCrih/eSpoty/issues"
	},
	"license": "MIT",
	"icon": "assets/espoty/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.espoty.client.ESpotyModClient"
		],
		"modmenu": [
			"com.espoty.compat.modmenu.ESpotyModMenuCompat"
		]
	},
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "${mc_dep}",
		"java": "${java_dep}",
		"fabric-api": "*"
	}
}
